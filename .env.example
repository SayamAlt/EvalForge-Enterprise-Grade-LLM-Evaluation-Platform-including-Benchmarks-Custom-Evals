# EvalForge — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to version control.
# Only set keys for providers you actually use — unused keys stay empty.

# Application
APP_NAME=EvalForge
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-64-char-string-at-minimum

# PostgreSQL database
DATABASE_URL=postgresql+asyncpg://evalforge:evalforge@localhost:5432/evalforge
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=evalforge-default

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=                        # Optional; leave blank for personal accounts

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google
GOOGLE_API_KEY=AIza...

# DeepSeek — covers deepseek-chat (V3) and deepseek-reasoner (R1)
DEEPSEEK_API_KEY=sk-...

# Qwen / Alibaba Cloud (DashScope) — covers qwen3-235b-a22b, qwen3-30b-a3b, qwen2.5 series
DASHSCOPE_API_KEY=sk-...

# Moonshot AI — covers kimi-k2, kimi-k3
MOONSHOT_API_KEY=sk-...

# MiniMax — covers MiniMax-M1, MiniMax-M3
MINIMAX_API_KEY=...
MINIMAX_GROUP_ID=...                  # Required by MiniMax API for auth

# Groq — covers llama-3.3-70b, llama-3.1-8b, gemma-2-9b, mixtral-8x7b via Groq LPU
GROQ_API_KEY=gsk_...

# Mistral — covers mistral-large-2 via API; mistral-nemo runs locally via Ollama
MISTRAL_API_KEY=...

# Writer — covers palmyra-x-004
WRITER_API_KEY=...

# Ollama — covers llama3, qwen2.5, deepseek-r1:7b, mistral-nemo, phi-4
# Also used for the neutral judge: prometheus-2-8x7b (pull: ollama pull prometheus2)
OLLAMA_BASE_URL=http://localhost:11434

# HuggingFace Hub — dataset downloads (MMLU, GSM8K, GPQA, etc.) + model weights
HUGGINGFACE_API_TOKEN=hf_...

# Evaluation settings
DEFAULT_MAX_TOKENS=2048
DEFAULT_TEMPERATURE=0.0               # Must be 0.0 for reproducible benchmark runs
EVAL_CONCURRENCY=10                   # Parallel API calls; lower if hitting rate limits
EVAL_TIMEOUT_SECONDS=60

# Judge config path — see configs/judge_config.yaml for Prometheus-2 setup
JUDGE_CONFIG_PATH=configs/judge_config.yaml

# Logging
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                       # json (prod) | console (dev)

# Celery (background evaluation workers)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2